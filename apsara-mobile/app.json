{
  "expo": {
    "name": "Apsara Mandya",
    "slug": "apsara-ice-cream",
    "version": "1.3.0",
    "orientation": "portrait",
    "primaryColor": "#1B5E4B",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.apsara.icecream",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E4B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ac3ad2f1-209c-45f1-9f67-374ffe9abb67"
      }
    }
  }
}
